#!/bin/sh
# ATLAS pre-push security gate: full-repo scan, stricter than pre-commit.
# Installed via scripts/security/install_git_hooks.sh (sets core.hooksPath).
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
PYTHON="$REPO_ROOT/.venv/Scripts/python.exe"
if [ ! -f "$PYTHON" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
fi
if [ ! -f "$PYTHON" ]; then
    PYTHON="python"
fi

echo "[security] running pre-push security gate (full scan)..."
"$PYTHON" "$REPO_ROOT/scripts/security/security_gate.py" --stage push
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "[security] BLOCKED: push fails the security gate. See security-reports/security-report.md"
    exit 1
fi

exit 0
