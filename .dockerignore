# =============================================================================
# Docker Build Context Exclusions
# This file reduces build context size and speeds up builds
#
# IMPORTANT: bare patterns like `*.sqlite` only match at the build-context
# ROOT in Docker's ignore matcher (unlike .gitignore, this is NOT recursive).
# Every pattern that must apply at any depth needs a `**/` prefix too.
# =============================================================================

# Runtime data directories (bind-mounted by docker-compose; never bake into image)
.atlas_cache/
.atlas_data/
outputs/

# Python virtual environments
.venv/
venv/
env/
ENV/
*.pyc
**/*.pyc
__pycache__/
**/__pycache__/
*.pyo
**/*.pyo
*.pyd
**/*.pyd
.Python

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
**/*.egg-info/
.installed.cfg
*.egg
**/*.egg
MANIFEST

# IDE and editor files
.vscode/
.idea/
*.swp
**/*.swp
*.swo
**/*.swo
*~
.DS_Store
**/.DS_Store
*.sublime-project
*.sublime-workspace

# Git files
.git/
.gitignore
.gitattributes

# Docker files (don't include in build context)
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# Documentation (can be excluded from runtime)
docs/
*.md
**/*.md
README*
LICENSE
CHANGELOG*

# Images and media (if not needed in production)
images/

# Testing and development
tests/
test_*.py
**/test_*.py
*_test.py
**/*_test.py
.pytest_cache/
**/.pytest_cache/
.coverage
**/.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
**/*.cover
.hypothesis/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Environment and configuration (use env vars instead)
.env
.env.*
*.env
**/*.env
.envrc

# Logs and temporary files
*.log
**/*.log
logs/
*.tmp
**/*.tmp
*.temp
**/*.temp
.cache/
**/.cache/

# OS-specific files
Thumbs.db
**/Thumbs.db
Desktop.ini
**/Desktop.ini

# Project-specific exclusions
outputs/*.md
outputs/*.pdf
history.json
learning/
examples/
visualization/

# Large binary files (if any) — these matter most: dev caches/DBs can be GBs
*.sqlite
**/*.sqlite
*.db
**/*.db
*.pkl
**/*.pkl
*.pickle
**/*.pickle

# Jupyter notebooks (if not needed in production)
*.ipynb
**/*.ipynb
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Node modules (if any frontend tooling)
node_modules/
**/node_modules/
npm-debug.log
yarn-error.log

# Local agent/tooling metadata (not needed at runtime)
.claude/
.codegraph/
.gitnexus/
.superpowers/
.ruff_cache/
**/.ruff_cache/
security-reports/
