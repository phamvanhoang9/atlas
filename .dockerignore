# =============================================================================
# Docker Build Context Exclusions
# This file reduces build context size and speeds up builds
# =============================================================================

# Python virtual environments
.venv/
venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Git files
.git/
.gitignore
.gitattributes

# Docker files (don't include in build context)
Dockerfile*
docker-compose*.yml
.docker/
.dockerignore

# Documentation (can be excluded from runtime)
docs/
*.md
README*
LICENSE
CHANGELOG*

# Images and media (if not needed in production)
images/

# Testing and development
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Environment and configuration (use env vars instead)
.env
.env.*
*.env
.envrc

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
.cache/

# OS-specific files
Thumbs.db
Desktop.ini

# Project-specific exclusions
outputs/*.md
outputs/*.pdf
history.json
learning/
examples/
visualization/

# Large binary files (if any)
*.sqlite
*.db
*.pkl
*.pickle

# Jupyter notebooks (if not needed in production)
*.ipynb
.ipynb_checkpoints/

# Node modules (if any frontend tooling)
node_modules/
npm-debug.log
yarn-error.log
