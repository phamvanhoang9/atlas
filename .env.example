# =============================================================================
# ATLAS Environment Configuration
# =============================================================================
# 
# SECURITY WARNING: Never commit this file with actual API keys!
# Copy this file to .env and fill in your actual values.
# 
# Usage:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your actual API keys
#   3. Run: docker-compose up -d
# =============================================================================

# OpenAI API Configuration
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tavily Search API Configuration
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Configuration
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Search API Configuration (Optional)
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_optional_google_api_key_here

# Google Custom Search Engine ID (Optional)
# Get your CX from: https://programmablesearchengine.google.com/
GOOGLE_CX_KEY=your_optional_google_cx_here

# =============================================================================
# Optional Configuration
# =============================================================================

# Application Environment (production, development, testing)
ATLAS_ENV=production

# Optional API/WebSocket auth token. Leave unset for local development.
# When set, clients must send Authorization: Bearer <token> or ?token=<token>.
ATLAS_AUTH_TOKEN=replace-with-a-long-random-token

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production startup validation. Set true in deploy environments.
REQUIRE_API_KEYS=true

# Cost-control caches. Enabled by default in runtime, disabled in tests.
ATLAS_CACHE_DB=.atlas_cache/cache.sqlite
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_SECONDS=86400
ENABLE_EMBEDDING_CACHE=true
EMBEDDING_CACHE_TTL_SECONDS=2592000

# Production history backend. Use sqlite for production, json for local compatibility.
HISTORY_BACKEND=sqlite
HISTORY_DB_PATH=.atlas_data/history.sqlite

# Local cross-encoder reranking. Docker production pre-downloads this model.
ENABLE_CROSS_ENCODER_RERANKING=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# Device for cross-encoder: "cuda", "cpu", or leave unset to auto-detect.
# CROSS_ENCODER_DEVICE=cuda

# HuggingFace token — optional but avoids unauthenticated rate-limit warnings.
# HF_TOKEN=hf_...

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
ATLAS_LOG_LEVEL=INFO

# Host and Port (when running without Docker)
HOST=127.0.0.1
PORT=8000

# Evaluation config
ENABLE_EVALUATION="true"
EVALUATION_MODE="online"
EVAL_LLM_PROVIDER="openai"
EVAL_LLM_MODEL="gpt-4o-mini"

# =============================================================================
# Daily automation email delivery (Phase: Daily AI Intelligence Automation)
# =============================================================================
# EMAIL_MODE: "smtp" to send real email, "mock" to log instead of sending.
# When SMTP settings below are incomplete, ATLAS automatically uses mock mode
# and records email_status="mocked" in the automation run history.
# EMAIL_MODE=mock

# SMTP transport — backend-only, never exposed to the frontend or stored in DB.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=atlas@example.com
# SMTP_PASSWORD=your_smtp_password_here
# SMTP_FROM=atlas@example.com
# SMTP_STARTTLS=true
